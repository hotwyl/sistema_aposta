# ============================================
# Banco de Dados MariaDB
# ============================================
DATABASE_URL=mysql://root:root@db:3306/sistema_aposta

# ============================================
# Redis - Cache de queries e fila de jobs
# ============================================
REDIS_URL=redis://redis:6379

# ============================================
# Aplicação
# ============================================
NUXT_PUBLIC_APP_NAME="Sistema de Aposta"
NUXT_PUBLIC_APP_VERSION="1.0.0"
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================
# IA - 9Router (gateway OpenAI-compatible, 40+ provedores)
# Docs: https://github.com/decolua/9router
# ============================================
# URL interna do 9Router no Docker (porta padrão 20128)
NINEROUTER_URL=http://9router:20128
# API Key gerada no dashboard do 9Router (http://localhost:20128)
NINEROUTER_API_KEY=
# Modelo (ex: auto/best, openai/gpt-4o-mini, anthropic/claude-3-haiku, google/gemini-2.0-flash)
NINEROUTER_MODEL=auto/best

# ============================================
# SMTP (opcional - notificações por e-mail)
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ============================================
# Observabilidade (opcional)
# ============================================
SENTRY_DSN=
