# ============================================
# Banco de Dados MariaDB
# ============================================
DATABASE_URL=mysql://root:root@db:3306/sistema_aposta

# ============================================
# Redis - Cache, Pub/Sub, Queue, Workers
# ============================================
REDIS_URL=redis://redis:6379

# ============================================
# Aplicação
# ============================================
NUXT_PUBLIC_APP_NAME="Sistema de Aposta"
NUXT_PUBLIC_APP_VERSION="1.0.0"

# ============================================
# IA - OmniRoute (gateway único para todos os modelos)
# Docs: https://github.com/diegosouzapw/OmniRoute
# ============================================
# URL interna do OmniRoute no Docker
OMNIROUTER_URL=http://omniroute:3000
# API Key gerada no dashboard do OmniRoute (http://localhost:20128)
OMNIROUTER_API_KEY=
# Modelo (ex: openai/gpt-4o-mini, anthropic/claude-3-haiku, google/gemini-2.0-flash)
OMNIROUTER_MODEL=openai/gpt-4o-mini
