{
  "name": "sistema-aposta",
  "version": "1.0.0",
  "description": "Sistema de Aposta - Análise e gestão inteligente de apostas em loterias brasileiras",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod": "docker compose up -d",
    "docker:prod:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "prepare": "husky"
  },
  "dependencies": {
    "@casl/ability": "^6.7.0",
    "@casl/vue": "^2.2.0",
    "@iconify/vue": "^4.3.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^1.9.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/i18n": "^10.4.1",
    "@nuxtjs/robots": "^5.7.1",
    "@nuxtjs/sitemap": "^7.6.0",
    "@pinia/nuxt": "^0.9.0",
    "@sentry/nuxt": "^9.27.0",
    "@tanstack/vue-query": "^5.75.0",
    "@tanstack/vue-table": "^8.21.3",
    "@tiptap/pm": "^2.12.0",
    "@tiptap/starter-kit": "^2.12.0",
    "@tiptap/vue-3": "^2.12.0",
    "@upstash/ratelimit": "^2.0.5",
    "@vee-validate/zod": "^4.15.0",
    "@vueuse/core": "^12.8.0",
    "@vueuse/nuxt": "^12.8.0",
    "apexcharts": "^5.10.0",
    "better-auth": "^1.2.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.39.0",
    "echarts": "^5.6.0",
    "file-type": "^20.4.0",
    "fuse.js": "^7.1.0",
    "maska": "^3.1.0",
    "mime": "^4.0.0",
    "motion-v": "^2.3.0",
    "mysql2": "^3.23.1",
    "nodemailer": "^6.10.0",
    "nuxt": "^3.16.0",
    "nuxt-schema-org": "^6.2.0",
    "nuxt-security": "^2.2.0",
    "pinia": "^2.3.0",
    "pino": "^9.7.0",
    "sharp": "^0.33.0",
    "sweetalert2": "^11.14.0",
    "unstorage": "^1.15.0",
    "uploadthing": "^7.6.0",
    "vee-validate": "^4.15.0",
    "vue": "^3.5.0",
    "vue-echarts": "^7.0.0",
    "vue-router": "^4.5.0",
    "vue3-apexcharts": "^1.8.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.7.0",
    "@nuxt/test-utils": "^3.17.0",
    "@nuxtjs/tailwindcss": "^6.12.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^3.1.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "happy-dom": "^20.11.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.4.0",
    "playwright-core": "^1.52.0",
    "postcss": "^8.4.49",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "shadcn-nuxt": "^0.11.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vite": "^8.1.5",
    "vitest": "^3.1.0"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
